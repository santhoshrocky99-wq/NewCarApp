@model CarCleanz.Models.Booking

<section class="payment-section" style="text-align:center; padding:40px; color:white;">

    <h2 style="color:#00ff7f; margin-bottom:20px;">
        Amount to Pay: ?@Model.Price
    </h2>

    <!-- QR CODE -->
    <div style="max-width:300px; margin:auto;">
        <img src="/images/paymentQR.png" alt="Payment QR"
             style="width:100%; border-radius:10px;" />
    </div>

    <!-- UPI ID -->
    <div style="margin-top:25px; font-size:18px;">
        <strong>UPI ID:</strong>
        <span id="upiText" style="font-size:18px; margin-left:5px;">yourupiid@bank</span>

        <!-- COPY ICON -->
        <span onclick="copyUPI()"
              style="cursor:pointer; margin-left:10px; font-size:20px; color:#00ff7f;">
            ??
        </span>
    </div>

    <!-- Instruction text -->
    <p style="margin-top:15px; font-size:15px; max-width:400px; margin:auto;">
        Once the payment is completed, click the <strong>Payment Done</strong> button below.
    </p>

    <!-- Payment Done Button -->
    <a href="/Booking/Success/@Model.Id"
       class="btn"
       style="background:#ff2d2d; color:#fff; padding:12px 25px;
              border-radius:6px; display:inline-block; text-decoration:none; margin-top:20px;">
        Payment Done
    </a>

</section>

<script>
    function copyUPI() {
        const text = document.getElementById("upiText").innerText;
        navigator.clipboard.writeText(text);
        alert("UPI ID copied: " + text);
    }
</script>