@model CarCleanz.Models.Booking

<section class="payment-section" style="text-align:center; padding:40px; color:white;">
    <h2 style="color:#00ff7f;">Amount to Pay: &#8377;@Model.Price</h2>

    <div style="margin-top:20px;">
        <img src="/images/paymentQR.png" alt="Payment QR"
             style="width:260px; border-radius:10px;" />
    </div>

    <p style="margin-top:15px; font-size:16px;">UPI ID:</p>

    <div style="display:flex; justify-content:center; align-items:center; gap:8px;">
        <span id="upiText" style="font-size:18px;">9940623869@kotak811</span>

        <!-- COPY ICON SVG -->
        <svg onclick="copyUPI()" style="cursor:pointer;" width="22" height="22" 
             fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M16 1H4a2 2 0 0 0-2 2v12h2V3h12V1zm3 4H8a2 2 0 0 0-2 2v12a2 
                     2 0 0 0 2 2h11a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2zm0 14H8V7h11v12z"/>
        </svg>
    </div>

    <p style="margin-top:15px; color:#bbb;">
        Once the payment is completed, click the <b>Payment Done</b> button below.
    </p>

    <a href="/Booking/Success/@Model.Id" 
       class="btn btn-danger" 
       style="background:#ff2d2d; color:white; padding:10px 25px; border-radius:6px;">
        Payment Done
    </a>
</section>

<script>
function copyUPI() {
    navigator.clipboard.writeText(document.getElementById("upiText").innerText);
    alert("UPI ID copied!");
}
</script>
