@model CarCleanz.Models.Booking

<section style="text-align:center; padding:40px; color:white;">

    <h2 style="color:#00ff7f;">Payment Successful</h2>

    <p>Thank you <b>@Model.Name</b>! Your booking is confirmed.</p>

    <div style="background:#111; margin:auto; padding:20px; border-radius:10px; width:350px;">
        <h3 style="color:red;">Your Booking ID:</h3>
        <h3 style="color:yellow;">@Model.CustomBookingId</h3>

        <h4 style="margin-top:20px;">Booking Details:</h4>
        <p>Apartment: <b>@Model.ApartmentName</b></p>
        <p>Vehicle: <b>@Model.VehicleType</b></p>
        <p>Car Number: <b>@Model.CarNumber</b></p>
        <p>Service Amount: <b>&#8377;@Model.Price</b></p>
    </div>

    <p style="margin-top:25px;">
        Please share your payment screenshot on WhatsApp.
    </p>

    <!-- WhatsApp Button -->
    <a href="https://wa.me/919940623869?text=Payment%20Done.%20Booking%20ID:%20@Model.CustomBookingId"
       style="display:inline-flex; align-items:center; gap:8px; 
              background:#25D366; color:white; padding:12px 20px; 
              border-radius:8px; text-decoration:none; font-size:18px;">
        
        <!-- WhatsApp Icon -->
        <svg width="24" height="24" fill="white" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 0C5.4 0 0 5.3 0 12c0 2.1.6 4.2 1.7 6L0 24l6.2-1.6c1.7.9 
                     3.6 1.3 5.6 1.3 6.6 0 12-5.3 12-12S18.6 0 12 0zm0 22c-1.8 
                     0-3.6-.5-5.1-1.4l-.4-.2-3.7 1 1-3.6-.2-.4C2.6 15.8 2 13.9 
                     2 12 2 6.5 6.5 2 12 2s10 4.5 10 10-4.5 10-10 10zm5-7.4c-.3-.2-1.8-.9-2-1-.3-.1-.5-.2-.7 
                     .2s-.8 1-.9 1.1c-.2.1-.3.1-.6 0s-1.2-.4-2.3-1.3c-.9-.8-1.3-1.7-1.4-2 
                     -.2-.3 0-.4.1-.6l.4-.5c.2-.3.3-.5.4-.7.1-.2 0-.4 0-.6s-.7-1.7-.9-2.3c-.2-.6-.5-.6-.7-.6h-.6c-.2 
                     0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.3 3.2c.2.3 2.1 3.2 5.1 4.5 
                     3 .1.4.1.7.1 1.1 0 2.1-.9 2.4-1.4.3-.5.3-1 .2-1.1z" />
        </svg>

        WhatsApp Now
    </a>

    <br><br>
    <a href="/" class="btn btn-secondary" style="margin-top:20px;">Go Home</a>

</section>