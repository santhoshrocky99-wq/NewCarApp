@model CarCleanz.Models.Booking

<section style="text-align:center; padding:40px; color:white;">
    <h2 style="color:#00ff6a;">Payment Successful ?</h2>

    <p>Thank you <strong>@Model.Name</strong>! Your booking is confirmed.</p>

    <h3>Your Booking ID:</h3>
    <p style="font-size:22px; color:#ff2d2d;">@Model.CustomBookingId</p>

    <h3>Booking Details:</h3>
    <p>Vehicle: @Model.VehicleType</p>
    <p>Car Number: @Model.CarNumber</p>
    <p>Service Amount: ?@Model.Price</p>

    <a href="/" class="btn btn-danger" style="margin-top:20px;">Go Home</a>
</section>